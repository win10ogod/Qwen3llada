{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- set add_vision_id = add_vision_id if add_vision_id is defined else false %}
{%- set _interleaved_thinking = enable_interleaved_thinking if enable_interleaved_thinking is defined else true %}
{%- set _has_tools = (tools is defined and tools and tools is iterable and tools is not mapping) %}

{%- macro render_content(content, do_vision_count, is_system_content=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if item is mapping %}
                {%- if item.type == 'image' or 'image' in item or 'image_url' in item %}
                    {%- if is_system_content %}
                        {{- raise_exception('System message cannot contain images.') }}
                    {%- endif %}
                    {%- if do_vision_count %}
                        {%- set image_count.value = image_count.value + 1 %}
                    {%- endif %}
                    {%- if add_vision_id %}
                        {{- 'Picture ' ~ image_count.value ~ ': ' }}
                    {%- endif %}
                    {{- '<|vision_start|><|image_pad|><|vision_end|>' }}
                {%- elif item.type == 'video' or 'video' in item or 'video_url' in item %}
                    {%- if is_system_content %}
                        {{- raise_exception('System message cannot contain videos.') }}
                    {%- endif %}
                    {%- if do_vision_count %}
                        {%- set video_count.value = video_count.value + 1 %}
                    {%- endif %}
                    {%- if add_vision_id %}
                        {{- 'Video ' ~ video_count.value ~ ': ' }}
                    {%- endif %}
                    {{- '<|vision_start|><|video_pad|><|vision_end|>' }}
                {%- elif 'text' in item %}
                    {{- item.text }}
                {%- else %}
                    {{- raise_exception('Unexpected item type in content.') }}
                {%- endif %}
            {%- elif item is string %}
                {{- item }}
            {%- else %}
                {{- raise_exception('Unexpected item type in content.') }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}

{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}

{%- set _effort_raw = (reasoning_effort | string | lower) if reasoning_effort is defined and reasoning_effort is not none else 'medium' %}
{%- if _effort_raw in ('xhigh', 'high', 'max', 'ultracode', 'extreme') %}
    {%- set resolved_reasoning_effort = 'xhigh' %}
{%- elif _effort_raw in ('low', 'minimal') %}
    {%- set resolved_reasoning_effort = 'low' %}
{%- elif _effort_raw == 'medium' %}
    {%- set resolved_reasoning_effort = 'medium' %}
{%- else %}
    {{- raise_exception('Unexpected reasoning effort ' ~ _effort_raw ~ '. Supported types are xhigh, medium, and low.') }}
{%- endif %}

{%- set reasoning_instructions = '' %}
{%- if resolved_reasoning_effort == 'xhigh' %}
    {%- set reasoning_instructions = 'Reasoning effort is set to xhigh. Please think carefully through the task, validate key assumptions, consider plausible alternatives, and prioritize correctness, consistency, and clarity in the final answer.' %}
{%- elif resolved_reasoning_effort == 'low' %}
    {%- set reasoning_instructions = 'Reasoning effort is set to low. Keep your thinking brief and focused, moving directly to the conclusion without unnecessary elaboration.' %}
{%- endif %}

{%- set head = namespace(count=0, seen_non_system=false) %}
{%- for message in messages %}
    {%- set _is_system = (message.role == 'system' or message.role == 'developer') %}
    {%- if _is_system and not head.seen_non_system %}
        {%- set head.count = head.count + 1 %}
    {%- else %}
        {%- set head.seen_non_system = true %}
    {%- endif %}
{%- endfor %}

{%- set system_state = namespace(content='') %}
{%- for message in messages[:head.count] %}
    {%- set _part = render_content(message.content, false, true) | trim %}
    {%- if _part %}
        {%- if system_state.content %}
            {%- set system_state.content = system_state.content ~ '\n\n' ~ _part %}
        {%- else %}
            {%- set system_state.content = _part %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- set _system_content = system_state.content %}
{%- set _messages = messages[head.count:] %}

{%- if _has_tools %}
    {{- '<|im_start|>system\n' }}
    {%- if reasoning_instructions %}
        {{- reasoning_instructions + '\n\n' }}
    {%- endif %}
    {{- '# Tools\n\nYou have access to the following functions:\n\n<tools>' }}
    {%- for tool in tools %}
        {{- '\n' }}
        {{- tool | tojson }}
    {%- endfor %}
    {{- '\n</tools>' }}
    {{- '\n\nIf you choose to call a function, use the following format and do not add text after the final </tool_call>:\n\n<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags\n- Required parameters MUST be specified\n- You may provide optional reasoning before the function call\n- After tool results, call another function if needed or answer the user normally\n- If no function call is needed, answer the question normally with your current knowledge\n</IMPORTANT>' }}
    {%- if _system_content %}
        {{- '\n\n' + _system_content }}
    {%- endif %}
    {{- '<|im_end|>\n' }}
{%- else %}
    {%- if _system_content or reasoning_instructions %}
        {{- '<|im_start|>system\n' }}
        {%- if reasoning_instructions %}
            {{- reasoning_instructions }}
            {%- if _system_content %}
                {{- '\n\n' }}
            {%- endif %}
        {%- endif %}
        {%- if _system_content %}
            {{- _system_content }}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- endif %}
{%- endif %}

{%- for message in _messages %}
    {%- set is_system = (message.role == 'system' or message.role == 'developer') %}
    {%- set content = render_content(message.content, true, is_system) | trim %}
    {%- if is_system %}
        {{- '<|im_start|>system\n' + content + '<|im_end|>\n' }}
    {%- elif message.role == 'user' %}
        {{- '<|im_start|>user\n' + content + '<|im_end|>\n' }}
    {%- elif message.role == 'assistant' %}
        {%- set reasoning_content = '' %}
        {%- if message.reasoning_content is defined and message.reasoning_content is not none %}
            {%- set reasoning_content = message.reasoning_content if message.reasoning_content is string else message.reasoning_content | string %}
        {%- elif message.thinking is defined and message.thinking is not none %}
            {%- set reasoning_content = message.thinking if message.thinking is string else message.thinking | string %}
        {%- elif message.reasoning is defined and message.reasoning is not none %}
            {%- set reasoning_content = message.reasoning if message.reasoning is string else message.reasoning | string %}
        {%- endif %}

        {%- if reasoning_content | trim %}
            {%- if content.startswith('<think>') and '</think>' in content %}
                {%- set content = content.split('</think>')[-1].lstrip('\n') %}
            {%- elif content.startswith('<thinking>') and '</thinking>' in content %}
                {%- set content = content.split('</thinking>')[-1].lstrip('\n') %}
            {%- elif content.startswith('</think>') %}
                {%- set content = content[8:].lstrip('\n') %}
            {%- elif content.startswith('</thinking>') %}
                {%- set content = content[11:].lstrip('\n') %}
            {%- endif %}
        {%- else %}
            {%- if content.startswith('<think>') and '</think>' in content %}
                {%- set reasoning_content = content.split('</think>')[0].split('<think>')[-1].strip() %}
                {%- set content = content.split('</think>')[-1].lstrip('\n') %}
            {%- elif content.startswith('<thinking>') and '</thinking>' in content %}
                {%- set reasoning_content = content.split('</thinking>')[0].split('<thinking>')[-1].strip() %}
                {%- set content = content.split('</thinking>')[-1].lstrip('\n') %}
            {%- elif '\n</think>' in content %}
                {%- set reasoning_content = content.split('\n</think>')[0].strip() %}
                {%- set content = content.split('\n</think>')[-1].lstrip('\n') %}
            {%- elif '\n</thinking>' in content %}
                {%- set reasoning_content = content.split('\n</thinking>')[0].strip() %}
                {%- set content = content.split('\n</thinking>')[-1].lstrip('\n') %}
            {%- elif content.startswith('</think>') %}
                {%- set content = content[8:].lstrip('\n') %}
            {%- elif content.startswith('</thinking>') %}
                {%- set content = content[11:].lstrip('\n') %}
            {%- endif %}
        {%- endif %}
        {%- set reasoning_content = reasoning_content | trim %}
        {%- set _after_tool_result = (not loop.first and loop.previtem.role == 'tool') %}
        {%- set _render_reasoning = (reasoning_content and (_interleaved_thinking or not _after_tool_result)) %}

        {%- if _render_reasoning %}
            {{- '<|im_start|>assistant\n<think>\n' + reasoning_content + '\n</think>\n\n' + content }}
        {%- else %}
            {{- '<|im_start|>assistant\n' + content }}
        {%- endif %}

        {%- if message.tool_calls is defined and message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping %}
            {%- for tool_call in message.tool_calls %}
                {%- set tc = tool_call.function if (tool_call.function is defined and tool_call.function is not none) else tool_call %}
                {%- if tc.name is not defined or tc.name is none or not tc.name %}
                    {{- raise_exception('Tool call is missing a function name.') }}
                {%- endif %}
                {%- if loop.first %}
                    {%- if content | trim %}
                        {{- '\n\n' }}
                    {%- endif %}
                {%- else %}
                    {{- '\n' }}
                {%- endif %}
                {{- '<tool_call>\n<function=' + tc.name + '>\n' }}
                {%- if tc.arguments is defined and tc.arguments is not none %}
                    {%- if tc.arguments is mapping %}
                        {%- for args_name, args_value in tc.arguments.items() %}
                            {{- '<parameter=' + args_name + '>\n' }}
                            {{- args_value if args_value is string else args_value | tojson }}
                            {{- '\n</parameter>\n' }}
                        {%- endfor %}
                    {%- else %}
                        {%- set _raw_args = tc.arguments if tc.arguments is string else tc.arguments | tojson %}
                        {%- if _raw_args %}
                            {{- _raw_args }}
                            {%- if not _raw_args.endswith('\n') %}
                                {{- '\n' }}
                            {%- endif %}
                        {%- endif %}
                    {%- endif %}
                {%- endif %}
                {{- '</function>\n</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- elif message.role == 'tool' %}
        {%- if loop.first or loop.previtem.role != 'tool' %}
            {{- '<|im_start|>user' }}
        {%- endif %}
        {{- '\n<tool_response>\n' + content + '\n</tool_response>' }}
        {%- if loop.last or loop.nextitem.role != 'tool' %}
            {{- '<|im_end|>\n' }}
        {%- endif %}
    {%- else %}
        {{- raise_exception('Unexpected message role: ' ~ message.role) }}
    {%- endif %}
{%- endfor %}

{%- if add_generation_prompt %}
    {%- set _generation_after_tool = (_messages | length > 0 and _messages[-1].role == 'tool') %}
    {%- if _interleaved_thinking or not _generation_after_tool %}
        {{- '<|im_start|>assistant\n<think>\n' }}
    {%- else %}
        {{- '<|im_start|>assistant\n' }}
    {%- endif %}
{%- endif %}